{
    "name": "zerofront/module-zero-quick-order",
    "description": "Zero for Magento Open Source: a quick order page: SKUs and quantities, a pasted list or a CSV file, straight into the cart.",
    "type": "magento2-module",
    "version": "1.3.5",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
